# Copy this file to .env and fill in real values
# Generate a new SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DEBUG=False
SECRET_KEY=replace-with-a-random-50-character-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS — your frontend URL(s), comma-separated
CORS_ALLOWED_ORIGINS=https://yourfrontend.com

# Master account bootstrap — used once on first login to create the superuser.
# Remove these vars after creating your real admin users for maximum security.
MASTER_USERNAME=
MASTER_PASSWORD=
MASTER_EMAIL=

# Database (only set on production if using Postgres/MySQL)
# DATABASE_URL=postgres://user:pass@host:5432/dbname
